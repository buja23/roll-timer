<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <queries><intent><action android:name="android.intent.action.TTS_SERVICE" /></intent></queries>
  <application>
    <service android:name=".TimerService" android:exported="false" android:stopWithTask="false" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started offline jiu-jitsu interval timer with precise audible transitions and pause/stop notification controls while screen is locked." />
    </service>
  </application>
</manifest>
